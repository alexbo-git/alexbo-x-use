{
  "twitter_automation": {
    "response_interval_seconds": 300,
    "max_tweets_per_keyword_scrape": 10,
    "media_directory": "data/media_files",
    "processed_tweets_file": "data/processed_tweets_log.csv",
    "cookie_file_per_account_in_accounts_json": true,
    "analysis_config": {
      "enable_relevance_filter": {
        "competitor_reposts": true,
        "likes": true,
        "keyword_replies": false
      },
      "thresholds": {
        "competitor_reposts_min": 0.5,
        "likes_min": 0.45,
        "keyword_replies_min": 0
      }
    },
    "engagement_decision": {
      "enabled": false,
      "use_sentiment": true,
      "thresholds": {
        "quote_min": 0.85,
        "retweet_min": 0.7,
        "repost_min": 0.6
      }
    },
    "action_config": {
      "min_delay_between_actions_seconds": 90,
      "max_delay_between_actions_seconds": 240,
      "enable_competitor_reposts": false,
      "max_posts_per_competitor_run": 0,
      "repost_only_tweets_with_media": false,
      "min_likes_for_repost_candidate": 0,
      "min_retweets_for_repost_candidate": 0,
      "competitor_post_interaction_type": "retweet",
      "enable_keyword_replies": false,
      "max_replies_per_keyword_run": 1,
      "reply_only_to_recent_tweets_hours": 8,
      "avoid_replying_to_own_tweets": true,
      "enable_content_curation_posts": false,
      "max_curated_posts_per_run": 0,
      "enable_liking_tweets": false,
      "max_likes_per_run": 3,
      "like_tweets_from_keywords": null,
      "like_tweets_from_feed": false,
      "enable_thread_analysis": true,
      "llm_settings_for_post": {
        "max_tokens": 300,
        "temperature": 0.7
      },
      "llm_settings_for_reply": {
        "max_tokens": 300,
        "temperature": 0.78
      },
      "llm_settings_for_thread_analysis": {
        "max_tokens": 300,
        "temperature": 0.1
      },
      "enable_keyword_retweets": false,
      "max_retweets_per_keyword_run": 0,
      "enable_community_engagement": false,
      "enable_community_likes": false,
      "enable_community_retweets": false,
      "max_community_engagements_per_run": 0,
      "enable_community_replies": false,
      "max_community_replies_per_run": 0,
      "community_reply_only_recent_tweets_hours": 8
    }
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(levelname)s - %(module)s - %(message)s"
  },
  "browser_settings": {
    "type": "chrome",
    "headless": true,
    "user_agent_generation": "random",
    "custom_user_agent": null,
    "proxy": null,
    "window_size": "1920,1080",
    "use_undetected_chromedriver": true,
    "enable_stealth": true,
    "login_wait_seconds": 0,
    "cookie_domain_url": "https://x.com",
    "driver_options": [
      "--no-sandbox",
      "--disable-dev-shm-usage",
      "--ignore-certificate-errors",
      "--disable-gpu",
      "--log-level=3",
      "--disable-notifications",
      "--disable-popup-blocking"
    ],
    "page_load_timeout_seconds": 30,
    "script_timeout_seconds": 30
  },
  "llm": {
    "api_key": "",
    "base_url": "",
    "model": "gpt-5-nano"
  },
  "mcp": {
    "draft_mode": false
  }
}
